# Copy to .env. Never commit .env. None of these are visible to PR code.

# --- Reviewers -------------------------------------------------------------
# LLM_PROVIDER: openrouter | anthropic | mock. Empty = auto (openrouter if its
# key is set, then anthropic, else the labelled MOCK LLM).
LLM_PROVIDER=
# For OpenRouter a comma-separated list is a fallback chain (max 3).
# Tested 2026-10-09 (about $0.002 per full review):
#   cheap: openai/gpt-oss-120b,openai/gpt-oss-20b
#   free:  nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-oss-20b
# Free models are rate limited (about 50 requests/day on small accounts) and may
# log prompts; do not send private code to them.
LLM_MODEL=
OPENROUTER_API_KEY=
# Provider routing: throughput (fastest, default) | latency | price
OPENROUTER_SORT=throughput
ANTHROPIC_API_KEY=

# --- Independent checker (maker != checker) ---------------------------------
# Use a model from a DIFFERENT family than LLM_MODEL. Runs through OpenRouter
# unless GEMINI_API_KEY is set (then it calls Gemini directly). Empty = skipped
# and findings are marked UNVERIFIED.
# Tested: google/gemini-2.5-flash-lite
CHECKER_PROVIDER=
CHECKER_MODEL=
GEMINI_API_KEY=

# --- Triage (TypeSafe Jev) ---------------------------------------------------
# One fast typed-classifier call per PR: injection screen, risk score, routing.
# Empty = skipped. Get a key at https://docs.typesafe.ai
JEV_API_KEY=
JEV_MODEL=jev-latest
# Optional stronger reviewer model, used for the security reviewer only when
# Jev rates a PR risky (cheap by default, strong only for the hard cases).
LLM_MODEL_STRONG=

# Replay identical LLM requests from runs/llm_cache (deterministic demo, no repeat cost).
LLM_CACHE=1

# --- Access control in GUARDED mode -----------------------------------------
# LOCAL_POLICY (stand-in) | FAILPROOFAI (every call goes through the failproofai
# PreToolUse hook; run scripts/failproofai_setup.sh first)
ENFORCER=LOCAL_POLICY
FAILPROOFAI_BIN=failproofai

# --- GitHub ------------------------------------------------------------------
# mock = offline fixtures from demo_target/, mcp = real GitHub MCP server
UPSTREAM=mock
GITHUB_MCP_URL=http://localhost:8081/mcp
# fine-grained, throwaway repos only, 1-day expiry
GITHUB_PAT_UNSAFE=
GITHUB_WEBHOOK_SECRET=

TARGET_REPO=you/prguard-demo-target
OTHER_REPO=you/prguard-demo-other
# UNSAFE mode runs PR code on this machine; only for PRs by these logins (default: TARGET_REPO owner)
UNSAFE_ALLOWED_AUTHORS=

HITL_THRESHOLD=0.7
# Per-agent timeout in seconds. Cheap models can take 10-40s on a first (uncached) call.
NODE_TIMEOUT_S=75
CANARY_URL=http://127.0.0.1:9999/canary
